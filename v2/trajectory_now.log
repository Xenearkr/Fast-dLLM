import string

def is_palindrome(s):
    # Remove punctuation and spaces, and convert to lowercase
    cleaned<mask> ''.join(char.lower() for char in s if char.isalnum())
    # Check if the cleaned string is equal to its reverse
    return cleaned ==<mask>

