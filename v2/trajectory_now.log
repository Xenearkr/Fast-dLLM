def find_common_elements(arr1, arr2):
    # Convert<mask> arrays<mask> sets to eliminate duplicates and allow for set operations
    set1 = set(arr1)
    set2 = set(arr2)

    # Find the<mask> of<mask> sets
    common_elements = set1.intersection(set2)

    # Convert the set of common elements back to a list
    return list(common_elements<mask><mask>

