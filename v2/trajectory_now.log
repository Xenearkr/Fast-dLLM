def validate_email(email):
    pattern = r'^[a-zA-Z<mask><mask><mask><mask><mask><mask><mask><mask>-zA-Z0-9-]+\.[a-zA-Z0-9-.]+$'
    if re.match(pattern, email<mask><mask><mask><mask><mask><mask><mask><mask>

# Example usage
