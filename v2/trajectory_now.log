How would you modify the code below to convert it into a class-based implementation of a linked list? Please provide the complete implementation including the `Node` and `LinkedList` classes.
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

def append(head, data):
    new_node = Node(data)
    if not head:
        return new_node
    last = head
    while last.next:
        last = last.next
    last.next = new_node
    return head
